{
  "name": "devops-services",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run build && node scripts/check-redesign.mjs && node scripts/check-scenery.mjs && node scripts/check-marketing.mjs",
    "test:browser": "node scripts/check-redesign.mjs",
    "screenshots": "npm run build && node scripts/capture-redesign.mjs",
    "model:build": "python scripts/prepare-characters.py",
    "format": "prettier --write src scripts/*.mjs index.html vite.config.ts vercel.json package.json README.md docs/*.md",
    "test:scenery": "node scripts/check-scenery.mjs",
    "vendor:storm": "node scripts/vendor-storm.mjs",
    "test:marketing": "node scripts/check-marketing.mjs",
    "predev": "node scripts/assemble-media.mjs",
    "prebuild": "node scripts/assemble-media.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/playfair-display": "5.2.6",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "gsap": "^3.15.0",
    "lenis": "1.3.19",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.0",
    "three-storm": "npm:three@0.143.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
